<div class="auth-container">
    <h1>Inscription</h1>

    <% if (typeof error !=='undefined' && error) { %>
        <div class="alert alert-error">
            <%= error %>
        </div>
        <% } %>

            <form action="/register" method="POST" class="auth-form">
                <div class="form-group">
                    <label for="username">Nom d'utilisateur</label>
                    <input type="text" id="username" name="username" required placeholder="ChefCinema" minlength="3">
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required placeholder="votre@email.com">
                </div>

                <div class="form-group">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="password" required placeholder="••••••••" minlength="6">
                </div>

                <button type="submit" class="btn btn-full">S'inscrire</button>
            </form>

            <p class="auth-footer">Déjà un compte ? <a href="/login">Connectez-vous</a></p>
</div>