<div class="recipe-detail">
    <div class="recipe-header">
        <h1>
            <%= recipe.title %>
        </h1>
        <% if (recipe.media) { %>
            <p class="subtitle">Inspiré de : <strong>
                    <%= recipe.media.title %>
                </strong> (<%= recipe.media.type %>)</p>
            <% } %>
    </div>

    <div class="recipe-meta">
        <span>Difficulté : <%= recipe.difficulty %></span>
        <% if (recipe.prep_time) { %>
            <span>Préparation : <%= recipe.prep_time %> min</span>
            <% } %>
                <% if (recipe.cook_time) { %>
                    <span>Cuisson : <%= recipe.cook_time %> min</span>
                    <% } %>
    </div>

    <div class="recipe-content">
        <% if (recipe.image_url) { %>
            <div class="recipe-image">
                <img src="<%= recipe.image_url %>" alt="<%= recipe.title %>">
            </div>
            <% } %>

                <div class="recipe-body">
                    <% if (recipe.description) { %>
                        <section class="description">
                            <h3>À propos</h3>
                            <p>
                                <%= recipe.description %>
                            </p>
                        </section>
                        <% } %>

                            <div class="columns">
                                <section class="ingredients">
                                    <h3>Ingrédients</h3>
                                    <div class="text-content">
                                        <%= recipe.ingredients %> <!-- Helper needed for newlines -->
                                    </div>
                                </section>

                                <section class="instructions">
                                    <h3>Instructions</h3>
                                    <div class="text-content">
                                        <%= recipe.instructions %>
                                    </div>
                                </section>
                            </div>
                </div>
    </div>

    <div class="actions">
        <a href="/recipes" class="btn-secondary">Retour aux recettes</a>
    </div>
</div>