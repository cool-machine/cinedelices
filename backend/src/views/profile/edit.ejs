<div class="recipes-header">
    <h1>🎬 Modifier mon profil</h1>
</div>

<div class="form-container">
    <% if (typeof error !=='undefined' && error) { %>
        <div class="alert alert-error">
            <%= error %>
        </div>
        <% } %>

            <form action="/profile/edit?_method=PUT" method="POST" class="auth-form">
                <div class="form-group">
                    <label for="username">Nom d'utilisateur</label>
                    <input type="text" id="username" name="username" required value="<%= user.username %>">
                </div>

                <div class="form-group">
                    <label for="avatar_url">URL de l'avatar</label>
                    <input type="url" id="avatar_url" name="avatar_url" value="<%= user.avatar_url || '' %>"
                        placeholder="https://...">
                </div>

                <div class="form-group">
                    <label for="bio">Biographie</label>
                    <textarea id="bio" name="bio" rows="5"
                        placeholder="Parlez-nous de vous et de votre passion pour le ciné-gastronomie..."><%= user.bio || '' %></textarea>
                </div>

                <div class="form-actions">
                    <a href="/profile/<%= user.id %>" class="btn btn-secondary">Annuler</a>
                    <button type="submit" class="btn btn-gold">💾 Enregistrer les modifications</button>
                </div>
            </form>
</div>