<div class="profile-header-container">
    <div class="profile-banner"></div>
    <div class="profile-info-wrapper">
        <div class="profile-avatar">
            <% if (profileUser.avatar_url) { %>
                <img src="<%= profileUser.avatar_url %>" alt="<%= profileUser.username %>">
                <% } else { %>
                    <div class="avatar-placeholder">
                        <%= profileUser.username.charAt(0).toUpperCase() %>
                    </div>
                    <% } %>
        </div>
        <div class="profile-details">
            <div class="profile-name-row">
                <h1>
                    <%= profileUser.username %>
                </h1>
                <% if (isOwnProfile) { %>
                    <a href="/profile/edit" class="btn btn-gold btn-small">Modifier le profil</a>
                    <% } %>
            </div>
            <% if (profileUser.bio) { %>
                <p class="profile-bio">
                    <%= profileUser.bio %>
                </p>
                <% } else { %>
                    <p class="profile-bio no-bio">Aucune biographie disponible.</p>
                    <% } %>
        </div>
    </div>
</div>

<div class="section-divider">
    <div class="divider-text">🍽️ Ses Recettes</div>
</div>

<div class="profile-recipes">
    <% if (profileUser.recipes && profileUser.recipes.length> 0) { %>
        <div class="recipes-grid">
            <% profileUser.recipes.forEach(recipe=> { %>
                <div class="recipe-card">
                    <div class="badge">
                        <%= recipe.category ? recipe.category.name : 'Recette' %>
                    </div>
                    <% if (recipe.image_url) { %>
                        <img src="<%= recipe.image_url %>" alt="<%= recipe.title %>">
                        <% } else { %>
                            <img src="https://images.unsplash.com/photo-1495195129352-aec325b55b65?q=80&w=400"
                                alt="Default">
                            <% } %>
                                <div class="card-content">
                                    <h3>
                                        <%= recipe.media ? recipe.media.title : 'Film / Série' %>
                                    </h3>
                                    <h2>
                                        <%= recipe.title %>
                                    </h2>
                                    <div class="recipe-meta">
                                        <span>⏱️ <%= recipe.prep_time + recipe.cook_time %> min</span>
                                        <span>📊 <%= recipe.difficulty %></span>
                                    </div>
                                    <a href="/recipes/<%= recipe.id %>" class="btn btn-gold btn-full">Voir la Scène</a>
                                </div>
                </div>
                <% }) %>
        </div>
        <% } else { %>
            <div class="no-results">
                <p>Cet utilisateur n'a pas encore partagé de recettes.</p>
                <% if (isOwnProfile) { %>
                    <a href="/recipes/new" class="btn btn-gold mt-1">Créer ma première recette</a>
                    <% } %>
            </div>
            <% } %>
</div>