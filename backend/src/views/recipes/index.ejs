<div class="recipes-header">
    <h1>Toutes nos Recettes</h1>
</div>

<!-- Search & Filters -->
<div class="search-filters">
    <form action="/recipes" method="GET" class="filter-form">
        <div class="search-box">
            <input type="text" name="search" placeholder="Rechercher une recette..." value="<%= search %>">
            <button type="submit" class="btn">🔍</button>
        </div>

        <div class="filter-dropdowns">
            <select name="category" onchange="this.form.submit()">
                <option value="">Toutes les catégories</option>
                <% if (typeof categories !=='undefined' ) { %>
                    <% categories.forEach(cat=> { %>
                        <option value="<%= cat.id %>" <%=selectedCategory==cat.id ? 'selected' : '' %>><%= cat.name %>
                        </option>
                        <% }) %>
                            <% } %>
            </select>

            <select name="media" onchange="this.form.submit()">
                <option value="">Tous les films/séries</option>
                <% if (typeof mediaList !=='undefined' ) { %>
                    <% mediaList.forEach(m=> { %>
                        <option value="<%= m.id %>" <%=selectedMedia==m.id ? 'selected' : '' %>><%= m.title %>
                        </option>
                        <% }) %>
                            <% } %>
            </select>
        </div>
    </form>
</div>

<div class="recipes-grid">
    <% if (recipes.length===0) { %>
        <p class="no-results">Aucune recette trouvée.</p>
        <% } else { %>
            <% recipes.forEach(recipe=> { %>
                <div class="recipe-card">
                    <% if (recipe.media) { %>
                        <div class="badge">
                            <%= recipe.media.type==='film' ? 'Film' : 'Série' %>
                        </div>
                        <% } %>
                            <% if (recipe.image_url) { %>
                                <img src="<%= recipe.image_url %>" alt="<%= recipe.title %>">
                                <% } %>
                                    <div class="card-content">
                                        <h2>
                                            <%= recipe.title %>
                                        </h2>
                                        <% if (recipe.media) { %>
                                            <p class="media-ref">
                                                <%= recipe.media.title %>
                                            </p>
                                            <% } %>
                                                <p>
                                                    <%= recipe.description ? recipe.description.substring(0, 80) + '...'
                                                        : '' %>
                                                </p>
                                                <a href="/recipes/<%= recipe.id %>" class="btn">Voir la recette</a>
                                    </div>
                </div>
                <% }) %>
                    <% } %>
</div>