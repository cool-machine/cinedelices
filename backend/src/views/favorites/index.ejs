<div class="favorites-page">
    <h1>Mes Favoris</h1>

    <div class="recipes-grid">
        <% if (recipes.length === 0) { %>
            <p class="no-favorites">Vous n'avez pas encore de favoris.</p>
        <% } else { %>
            <% recipes.forEach(recipe => { %>
                <div class="recipe-card">
                    <% if (recipe.media) { %>
                        <div class="badge">
                            <%= recipe.media.type === 'film' ? 'Film' : 'Série' %>
                        </div>
                    <% } %>
                    <% if (recipe.image_url) { %>
                        <img src="<%= recipe.image_url %>" alt="<%= recipe.title %>">
                    <% } %>
                    <div class="card-content">
                        <h2><%= recipe.title %></h2>
                        <% if (recipe.media) { %>
                            <p class="media-ref"><%= recipe.media.title %></p>
                        <% } %>
                        <p><%= recipe.description ? recipe.description.substring(0, 80) + '...' : '' %></p>
                        <div class="card-actions">
                            <a href="/recipes/<%= recipe.id %>" class="btn">Voir la recette</a>
                            <form action="/recipes/<%= recipe.id %>/favorite" method="POST" class="inline-form">
                                <button type="submit" class="favorite-btn is-favorited" title="Retirer des favoris">❤️</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>
