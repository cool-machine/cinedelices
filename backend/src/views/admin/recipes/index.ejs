<div class="admin-recipes">
    <h1>Gestion des Recettes</h1>

    <% if (recipes.length === 0) { %>
        <p>Aucune recette disponible.</p>
    <% } else { %>
        <div class="recipes-table">
            <% recipes.forEach(recipe => { %>
                <div class="recipe-row">
                    <div class="recipe-info">
                        <strong><%= recipe.title %></strong>
                        <% if (recipe.author) { %>
                            <span>par <%= recipe.author.username %></span>
                        <% } %>
                    </div>
                    <div class="recipe-actions">
                        <a href="/admin/recipes/<%= recipe.id %>/edit" class="btn btn-secondary">Modifier</a>
                        <form action="/admin/recipes/<%= recipe.id %>?_method=DELETE" method="POST" class="inline-form">
                            <button type="submit" class="btn btn-danger">Supprimer</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>
