<% if (featuredRecipe) { %>
    <!-- Hero Section with Film Strips -->
    <section class="hero-wrapper">
        <!-- Left Film Strip -->
        <div class="film-strip film-strip-left">
            <div class="sprocket"></div>
            <div class="sprocket"></div>
            <div class="sprocket"></div>
            <div class="sprocket"></div>
            <div class="sprocket"></div>
            <div class="sprocket"></div>
            <div class="sprocket"></div>
            <div class="sprocket"></div>
        </div>

        <!-- Main Hero Content -->
        <section class="hero-cinema"
            style="background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.7)), url('<%= featuredRecipe.image_url || 'https://images.unsplash.com/photo-1485846234645-a62644f84728?q=80&w=1200' %>'); background-size: cover; background-position: center;">

            <!-- Film Projector Graphic -->
            <div class="film-projector">
                <svg viewBox="0 0 100 100" width="120" height="120">
                    <circle cx="30" cy="30" r="18" fill="#1a1a1a" stroke="#D4AF37" stroke-width="2" />
                    <circle cx="30" cy="30" r="12" fill="transparent" stroke="#D4AF37" stroke-width="1" />
                    <circle cx="70" cy="30" r="18" fill="#1a1a1a" stroke="#D4AF37" stroke-width="2" />
                    <circle cx="70" cy="30" r="12" fill="transparent" stroke="#D4AF37" stroke-width="1" />
                    <rect x="20" y="50" width="60" height="35" rx="5" fill="#1a1a1a" stroke="#D4AF37"
                        stroke-width="2" />
                    <circle cx="85" cy="67" r="8" fill="#D4AF37" opacity="0.8" />
                    <line x1="85" y1="67" x2="100" y2="55" stroke="#D4AF37" stroke-width="3" opacity="0.6" />
                    <line x1="85" y1="67" x2="100" y2="67" stroke="#D4AF37" stroke-width="3" opacity="0.6" />
                    <line x1="85" y1="67" x2="100" y2="79" stroke="#D4AF37" stroke-width="3" opacity="0.6" />
                </svg>
            </div>

            <div class="hero-content">
                <h2 class="section-title">🎬 En Vedette</h2>
                <div class="hero-featured">
                    <h1>
                        <%= featuredRecipe.title %>
                    </h1>
                    <% if (featuredRecipe.media) { %>
                        <span class="hero-badge">
                            <%= featuredRecipe.media.type==='film' ? '🎬' : '📺' %>
                                <%= featuredRecipe.media.title %>
                        </span>
                        <% } %>
                            <p class="anecdote">
                                <%= featuredRecipe.anecdote ? featuredRecipe.anecdote.substring(0, 150) + '...' :
                                    featuredRecipe.description %>
                            </p>
                            <a href="/recipes/<%= featuredRecipe.id %>" class="btn btn-gold">Voir la recette & le
                                film</a>
                </div>
            </div>
        </section>

        <!-- Right Film Strip -->
        <div class="film-strip film-strip-right">
            <div class="sprocket"></div>
            <div class="sprocket"></div>
            <div class="sprocket"></div>
            <div class="sprocket"></div>
            <div class="sprocket"></div>
            <div class="sprocket"></div>
            <div class="sprocket"></div>
            <div class="sprocket"></div>
        </div>
    </section>
    <% } %>

        <!-- Now Playing Section -->
        <div class="now-playing-header">
            <div class="reel-icon">🎞️</div>
            <h2>Now Playing: Culinary Features</h2>
            <div class="reel-icon">🎞️</div>
        </div>

        <div class="recipes-grid">
            <% if (recipes && recipes.length> 0) { %>
                <% recipes.forEach(recipe=> { %>
                    <div class="recipe-card">
                        <% if (recipe.media) { %>
                            <div class="badge">
                                <%= recipe.media.type==='film' ? 'Film' : 'Série' %>
                            </div>
                            <% } %>
                                <% if (recipe.image_url) { %>
                                    <img src="<%= recipe.image_url %>" alt="<%= recipe.title %>">
                                    <% } else { %>
                                        <img src="https://via.placeholder.com/400x200?text=<%= encodeURIComponent(recipe.title) %>"
                                            alt="<%= recipe.title %>">
                                        <% } %>
                                            <div class="card-content">
                                                <h3>
                                                    <%= recipe.media ? recipe.media.title + ':' : '' %>
                                                </h3>
                                                <h2>
                                                    <%= recipe.title %>
                                                </h2>
                                                <p class="recipe-meta">
                                                    <%= recipe.description ? recipe.description.substring(0, 60) + '...'
                                                        : '' %>
                                                </p>
                                                <a href="/recipes/<%= recipe.id %>" class="btn btn-small">Voir
                                                    Recette</a>
                                            </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <p class="no-results">Aucune recette disponible pour le moment.</p>
                            <% } %>
        </div>

        <!-- Coming Soon Section -->
        <div class="coming-soon-section">
            <div class="coming-soon-header">
                <h2>🎬 Coming Soon: Film Festival Favorites</h2>
            </div>
            <div class="coming-soon-grid">
                <div class="coming-soon-card">
                    <div class="coming-soon-overlay">Prochainement</div>
                    <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?q=80&w=400"
                        alt="Coming Soon">
                    <div class="coming-soon-info">
                        <h3>The Grand Budapest Hotel</h3>
                        <p>Mendl's Courtesan au Chocolat</p>
                    </div>
                </div>
                <div class="coming-soon-card">
                    <div class="coming-soon-overlay">Prochainement</div>
                    <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?q=80&w=400"
                        alt="Coming Soon">
                    <div class="coming-soon-info">
                        <h3>Avengers</h3>
                        <p>Shawarma Sandwich</p>
                    </div>
                </div>
                <div class="coming-soon-card">
                    <div class="coming-soon-overlay">Prochainement</div>
                    <img src="https://images.unsplash.com/photo-1551024601-bec78aea704b?q=80&w=400" alt="Coming Soon">
                    <div class="coming-soon-info">
                        <h3>Ghostbusters</h3>
                        <p>Stay Puft S'mores</p>
                    </div>
                </div>
            </div>
        </div>