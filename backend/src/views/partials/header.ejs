<header>
    <nav>
        <div class="logo">
            <a href="/">CinéDélices</a>
        </div>
        <ul>
            <li><a href="/recipes">Recettes</a></li>
            <% if (typeof user !== 'undefined' && user) { %>
                <li><a href="/recipes/new">Ajouter une recette</a></li>
                <li><a href="/favorites">Mes Favoris</a></li>
                <li><a href="/profile/<%= user.id %>">Mon Profil</a></li>
